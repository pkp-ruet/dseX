MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=dsex
REQUEST_DELAY=1.5
REQUEST_TIMEOUT=30
MAX_RETRIES=3

# Next.js frontend (Vercel / local): backend base URL, no trailing slash.
# Prefer API_URL on Vercel so server-rendered pages use the correct host; NEXT_PUBLIC_* is required for browser fetches (auth, price history).
# NEXT_PUBLIC_API_URL=https://your-api.example.com
# API_URL=https://your-api.example.com
