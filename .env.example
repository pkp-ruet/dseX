MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=dsex
REQUEST_DELAY=1.5
REQUEST_TIMEOUT=30
MAX_RETRIES=3

# Next.js frontend (Vercel / local): backend base URL, no trailing slash.
# Prefer API_URL on Vercel so server-rendered pages use the correct host; NEXT_PUBLIC_* is required for browser fetches (auth, price history).
# NEXT_PUBLIC_API_URL=https://your-api.example.com
# API_URL=https://your-api.example.com

# Email — Resend transactional API (re-engagement campaigns). Set RESEND_API_KEY
# on Render before any real send. topstockbd.com must be domain-authenticated
# (DKIM/SPF) in the Resend dashboard first.
# RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=hello@topstockbd.com
# EMAIL_FROM_NAME=TopStock BD
# EMAIL_REPLY_TO=hello@topstockbd.com
# Absolute bases for links in emails (CTA → site; open-pixel + unsubscribe → API)
# PUBLIC_SITE_URL=https://www.topstockbd.com
# PUBLIC_API_BASE_URL=https://dsex.onrender.com

# Plain-Bangla "এক নজরে" stock summaries (python main.py generate-summaries).
# Defaults to a free, offline template renderer — no setting needed. To use
# Claude for more natural prose instead, set both of these:
# SUMMARY_BACKEND=ai
# ANTHROPIC_API_KEY=
