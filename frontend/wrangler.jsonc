{
  // Cloudflare Worker for the Next.js frontend (OpenNext adapter).
  // Deploy: `npm run deploy` (or the "Deploy frontend" GitHub Action).
  // One-time setup (bucket, database, secrets): see CLOUDFLARE.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "topstockbd",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "services": [
    {
      // Self-reference, used by the cache. Must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "topstockbd"
    }
  ],
  "r2_buckets": [
    {
      // The page cache. Create once: npx wrangler r2 bucket create topstockbd-cache
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "topstockbd-cache"
    }
  ],
  "d1_databases": [
    {
      // Cache tags (created 2026-11-10, region APAC).
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "topstockbd-tags",
      "database_id": "5bd229a5-ebd7-4dbb-be09-4b438552b859"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }
  ],
  "vars": {
    "API_URL": "https://dsex.onrender.com",
    "NEXT_PUBLIC_API_URL": "https://dsex.onrender.com",
    "NEXT_PUBLIC_BASE_URL": "https://www.topstockbd.com"
  }
  // Secret (not in this file): REVALIDATE_SECRET
  //   npx wrangler secret put REVALIDATE_SECRET
}
